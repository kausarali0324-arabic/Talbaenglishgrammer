        }

        body {
            background-color: #f4f7f6;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        /* ہیڈر اور نیویگیشن بٹنز */
        .header-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .nav-btn {
            background: #e0e0e0;
            color: #333;
            padding: 8px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            transition: 0.3s;
        }

        .nav-btn:hover {
            background: #bdc3c7;
        }

        .creator-tag {
            font-size: 14px;
            color: #e74c3c;
            font-weight: bold;
            background: #fde8e8;
            padding: 5px 12px;
            border-radius: 20px;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 5px;
            font-size: 26px;
        }

        .subtitle {
            text-align: center;
            color: #7f8c8d;
            margin-bottom: 25px;
            font-size: 15px;
        }

        .class-list {
            list-style: none;
        }

        .class-item {
            margin-bottom: 15px;
        }

        .class-link {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ffffff;
            border: 2px solid #e0e0e0;
            padding: 15px 20px;
            border-radius: 8px;
            text-decoration: none;
            color: #2c3e50;
            font-size: 18px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .class-link:hover {
            background: #3498db;
            color: #ffffff;
            border-color: #3498db;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(52, 152, 219, 0.3);
        }

        .class-title {
            display: flex;
            flex-direction: column;
        }

        .topic-name {
            font-size: 14px;
            font-weight: normal;
            color: #555;
            margin-top: 4px;
        }

        .class-link:hover .topic-name {
            color: #ecf0f1;
        }

        .badge {
            background: #e74c3c;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .class-link:hover .badge {
            background: #ffffff;
            color: #e74c3c;
        }

        /* کاپی رائٹ سیکشن */
        .footer-copyright {
            text-align: center;
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #eee;
            font-size: 13px;
            color: #7f8c8d;
            line-height: 1.6;
        }

        @media (max-width: 600px) {
            .container {
                padding: 15px;
            }
            .class-link {
                font-size: 16px;
                padding: 12px 15px;
            }
            .header-nav {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
